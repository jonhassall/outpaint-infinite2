# Required: first accept the Krea 2 gated model license on Hugging Face.
HF_TOKEN=hf_replace_me

# Server
HOST_PORT=8000
CONTAINER_PORT=8000
PORT=8000
API_KEY=
UI_USERNAME=
UI_PASSWORD=
MAX_UPLOAD_MB=30
PRELOAD_MODEL=1

# Inference
BASE_MODEL=krea/Krea-2-Turbo
OUTPAINT_REPO=yijunwang2/krea2-outpaint
OUTPAINT_REVISION=8e1be6098331d7650398c806f23f4163431cbe68
OUTPAINT_WEIGHT=krea2_outpaint_rank32.safetensors
DEVICE=cuda
TORCH_DTYPE=auto
MAX_CANVAS=1280
SOURCE_MAX_EDGE=384
SEAM_PX=32

# Lower-VRAM options. Enable only one.
CPU_OFFLOAD=0
SEQUENTIAL_CPU_OFFLOAD=0

# Docker build. cu126 is the current broadly supported stable PyTorch wheel channel.
TORCH_VERSION=2.13.0
TORCH_INDEX_URL=https://download.pytorch.org/whl/cu126
